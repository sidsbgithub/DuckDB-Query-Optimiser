# name: test/sql/benchmark.test
# description: the public benchmark must return what vanilla DuckDB returns
# group: [sql]
#
# Generated by scripts/gen-benchmark-test.py - do not edit by hand.
# Expected values were recorded from vanilla DuckDB with the extension
# unloaded, so a passing run means your extension changed timings only.
#
# Needs data/imdb.duckdb: python3 ./scripts/download-imdb.py

require waddle

# The IMDB database is 2.7GB, downloaded locally and never committed, so it
# does not exist in CI. Without this guard the test fails there and the build
# counts as unsuccessful -- and only successful builds are graded. Run locally
# with:  IMDB_DATA=1 make test
require-env IMDB_DATA

statement ok
ATTACH 'data/imdb.duckdb' AS imdb (READ_ONLY);

statement ok
USE imdb;

statement ok
SET threads = 6;

statement ok
SET memory_limit = '8000MB';

statement ok
SET preserve_insertion_order = false;

