# q0122.sql
# More than one legal answer: LIMIT over an order that does not fully
# determine the top rows, so *which* rows come back is not a fact about
# this query. Proven, not sampled - see gen-benchmark-test.py.
# Only its cardinality can be asserted:
query I nosort
SELECT count(*) FROM (
SELECT pi.info
FROM person_info pi
JOIN info_type it ON pi.info_type_id = it.id
WHERE it.info = 'height'
  AND pi.info NOT SIMILAR TO '[0-9]''( [0-9]+( 1/2)?")?'
  AND pi.info NOT SIMILAR TO '[0-9]+ cm'
LIMIT 30
) _rows;
----
30

# ...so the content is pinned on the deterministic form of q0122 instead:
#   same query with the LIMIT dropped and ORDER BY ALL added.
query T nosort
