# q0225.sql
# More than one legal answer: LIMIT over an order that does not fully
# determine the top rows, so *which* rows come back is not a fact about
# this query. Proven, not sampled - see gen-benchmark-test.py.
# Only its cardinality can be asserted:
query I nosort
SELECT count(*) FROM (
WITH wkw_movies AS
  (SELECT ci.movie_id
   FROM cast_info ci
   WHERE ci.person_id = 1697404
     AND ci.role_id = 8)
SELECT k.keyword,
       count(*) c
FROM movie_keyword mk
JOIN wkw_movies wm ON mk.movie_id = wm.movie_id
JOIN keyword k ON k.id = mk.keyword_id
GROUP BY k.keyword
ORDER BY c DESC
LIMIT 30
) _rows;
----
30

# ...so the content is pinned on the deterministic form of q0225 instead:
#   same query with the LIMIT dropped and ORDER BY ALL added.
query TI nosort
SELECT * FROM (
WITH wkw_movies AS
  (SELECT ci.movie_id
   FROM cast_info ci
   WHERE ci.person_id = 1697404
     AND ci.role_id = 8)
SELECT k.keyword,
       count(*) c
FROM movie_keyword mk
JOIN wkw_movies wm ON mk.movie_id = wm.movie_id
JOIN keyword k ON k.id = mk.keyword_id
GROUP BY k.keyword
ORDER BY c DESC
) _all ORDER BY ALL;
----
1302 values hashing to 9ef5b45e06f73e67020614ccb0951239

