# q0298.sql
# More than one legal answer: LIMIT over an order that does not fully
# determine the top rows, so *which* rows come back is not a fact about
# this query. Proven, not sampled - see gen-benchmark-test.py.
# Only its cardinality can be asserted:
query I nosort
SELECT count(*) FROM (
SELECT k.keyword,
       count(*) AS cnt
FROM movie_companies mc
JOIN company_type ct ON ct.id = mc.company_type_id
JOIN movie_keyword mk ON mk.movie_id = mc.movie_id
JOIN keyword k ON k.id = mk.keyword_id
WHERE mc.company_id = 1310
  AND ct.kind = 'production companies'
GROUP BY k.keyword
ORDER BY cnt DESC
LIMIT 20
) _rows;
----
20

# ...so the content is pinned on the deterministic form of q0298 instead:
#   same query with the LIMIT dropped and ORDER BY ALL added.
query TI nosort
SELECT * FROM (
SELECT k.keyword,
       count(*) AS cnt
FROM movie_companies mc
JOIN company_type ct ON ct.id = mc.company_type_id
JOIN movie_keyword mk ON mk.movie_id = mc.movie_id
JOIN keyword k ON k.id = mk.keyword_id
WHERE mc.company_id = 1310
  AND ct.kind = 'production companies'
GROUP BY k.keyword
ORDER BY cnt DESC
) _all ORDER BY ALL;
----
7532 values hashing to 9041f2262489f9b2137af997f874ed0c

