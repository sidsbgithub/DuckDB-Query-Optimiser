# q0019.sql
query ITITI rowsort
WITH directors AS
  (SELECT ci.movie_id,
          ci.person_id AS director_id
   FROM cast_info ci
   JOIN title t ON t.id = ci.movie_id
   WHERE ci.role_id = 8
     AND t.kind_id =
       (SELECT id
        FROM kind_type
        WHERE kind = 'movie')),
     cinematographers AS
  (SELECT ci.movie_id,
          ci.person_id AS cine_id
   FROM cast_info ci
   JOIN title t ON t.id = ci.movie_id
   WHERE ci.role_id = 5
     AND t.kind_id =
       (SELECT id
        FROM kind_type
        WHERE kind = 'movie'))
SELECT d.director_id,
       nd.name AS director_name,
       c.cine_id,
       nc.name AS cinematographer_name,
       COUNT(DISTINCT d.movie_id) AS films_together
FROM directors d
JOIN cinematographers c ON d.movie_id = c.movie_id
JOIN name nd ON nd.id = d.director_id
JOIN name nc ON nc.id = c.cine_id
WHERE d.director_id != c.cine_id
GROUP BY d.director_id,
         nd.name,
         c.cine_id,
         nc.name
ORDER BY films_together DESC
LIMIT 15
----
75 values hashing to 166c8ba4d3dbcb743ce3a143616d4bf1

