# name: test/sql/recycling_eligibility.test
# description: context-dependent subtrees are skipped and counted under their skip reason
# group: [sql]

require waddle

# These tests observe pipeline breakers; whole query results are tested in recycling_query_result.test.
statement ok
SET GLOBAL waddle_recycling_query_results = false;

statement ok
CREATE TABLE recycling_eligibility_values AS SELECT i AS value FROM range(10) t(i);

# random() is volatile: the aggregate is never looked up or captured.
query I
SELECT count(*) FROM recycling_eligibility_values WHERE random() >= 0;
----
10

query I
SELECT count(*) FROM recycling_eligibility_values WHERE random() >= 0;
----
10

query IIII
SELECT lookups, captures, skipped_volatile, skipped_unsupported FROM waddle_recycling_stats();
----
0	0	2	0

# A table function is not a database table: its output is not tied to a snapshot.
query I
SELECT count(*) FROM range(10);
----
10

query II
SELECT lookups, skipped_external_scan FROM waddle_recycling_stats();
----
0	1

# A temporary table belongs to one connection, but recycled results are shared by the database.
statement ok
CREATE TEMP TABLE recycling_eligibility_temp AS SELECT i AS value FROM range(10) t(i);

query I
SELECT sum(value) FROM recycling_eligibility_temp;
----
45

query II
SELECT lookups, skipped_temp_object FROM waddle_recycling_stats();
----
0	1

# The CTE definition is recyclable; the aggregate over its reference is skipped.
query I
WITH above AS MATERIALIZED (SELECT value FROM recycling_eligibility_values WHERE value > 2)
SELECT count(*) FROM above;
----
7

query II
SELECT lookups, skipped_cte_reference FROM waddle_recycling_stats();
----
1	1

# A correlated subquery reads the outer rows through a delim get.
query II
SELECT a.value, (SELECT count(*) FROM recycling_eligibility_values b WHERE b.value < a.value)
FROM recycling_eligibility_values a ORDER BY a.value LIMIT 3;
----
0	0
1	1
2	2

query II
SELECT lookups, skipped_delim_get FROM waddle_recycling_stats();
----
1	2

# The outer aggregate contains the inner one's volatile filter: one cause, counted once.
query I
SELECT count(*) FROM (
    SELECT value % 3 AS key, sum(value) FROM recycling_eligibility_values WHERE random() >= 0 GROUP BY key
);
----
3

query II
SELECT lookups, skipped_volatile FROM waddle_recycling_stats();
----
1	3

query IIIIIII
SELECT skipped_volatile, skipped_parameter, skipped_external_scan, skipped_temp_object, skipped_cte_reference,
       skipped_delim_get, skipped_unsupported FROM waddle_recycling_stats();
----
3	0	1	1	1	2	0
