# name: test/sql/recycling_without_optimizer.test
# description: a connection that plans without the recycling optimizer still invalidates and announces its writes
# group: [sql]

require waddle

# These tests observe pipeline breakers; whole query results are tested in recycling_query_result.test.
statement ok
SET GLOBAL waddle_recycling_query_results = false;

statement ok
CREATE TABLE recycling_unoptimized_values AS SELECT i AS value FROM range(1000) t(i);

query I
SELECT sum(value) FROM recycling_unoptimized_values;
----
499500

# DuckDB skips extension optimizers for every connection while this is set. First a connection that has never
# planned a statement with the optimizer on writes.
statement ok
SET GLOBAL disabled_optimizers = 'extension';

statement ok con1
INSERT INTO recycling_unoptimized_values VALUES (1000);

statement ok
RESET GLOBAL disabled_optimizers;

query I
SELECT sum(value) FROM recycling_unoptimized_values;
----
500500

# Then the connection that loaded the extension.
statement ok
SET GLOBAL disabled_optimizers = 'extension';

statement ok
INSERT INTO recycling_unoptimized_values VALUES (1001);

statement ok
RESET GLOBAL disabled_optimizers;

query I
SELECT sum(value) FROM recycling_unoptimized_values;
----
501501

query II
SELECT hits, invalidations FROM waddle_recycling_stats();
----
0	3

# The result captured after the last write replays.
query I
SELECT sum(value) FROM recycling_unoptimized_values;
----
501501

# A write planned without the optimizer is still in flight until it commits: nothing is replayed meanwhile.
statement ok
SET GLOBAL disabled_optimizers = 'extension';

statement ok con2
BEGIN TRANSACTION;

statement ok con2
INSERT INTO recycling_unoptimized_values VALUES (1002);

statement ok
RESET GLOBAL disabled_optimizers;

query I con3
SELECT sum(value) FROM recycling_unoptimized_values;
----
501501

query II con3
SELECT hits, invalidations FROM waddle_recycling_stats();
----
1	3

statement ok con2
COMMIT;

query I con3
SELECT sum(value) FROM recycling_unoptimized_values;
----
502503

query II con3
SELECT hits, invalidations FROM waddle_recycling_stats();
----
1	4
